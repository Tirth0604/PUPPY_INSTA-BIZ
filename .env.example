# Supabase transaction-pooler connection URL. Server only. Never NEXT_PUBLIC.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# sqlite is only for local demos/tests; use postgres on Vercel.
ENQUIRY_STORAGE=postgres
LOCAL_DATABASE_PATH=.local/enquiries.sqlite
# Secret used to hash rate-limit IP identifiers; set a random value in production.
RATE_LIMIT_SECRET=replace-with-random-secret
NEXT_PUBLIC_WHATSAPP_PHONE=919898124987
NEXT_PUBLIC_CONTACT_EMAIL=info@instabizweb.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_PHONE=+919898124987
# Optional verified destinations. The demo map defaults to the Downtown Dubai area.
NEXT_PUBLIC_SHOWROOM_MAP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
